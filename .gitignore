# ========================================================
# AquaFuzz AI - Public GitHub GitIgnore
# Author: Ashank Gupta
# ========================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
.next/
out/
build/
dist/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Environment Variables (Keep sensitive keys private)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel Deployment
.vercel

# TypeScript & Build Cache
*.tsbuildinfo
next-env.d.ts
.turbo/
